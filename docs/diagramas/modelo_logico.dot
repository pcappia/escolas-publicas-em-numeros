digraph L {
 graph [rankdir=LR, fontname="DejaVu Sans", labelloc=b, fontsize=11, nodesep=0.35, ranksep=1.1, pad=0.3,
   label=<<BR/><B>Modelo lógico – Escolas públicas em atividade (Censo Escolar 2025)</B><BR/>Integrantes: Pâmela Cappia Torres; [inserir nome completo dos demais integrantes do grupo]<BR/>CST em Banco de Dados · Laboratório de Desenvolvimento de Banco de Dados V · Profa. Mariana Rodrigues Santesso>];
