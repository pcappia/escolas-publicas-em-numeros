digraph C {
 graph [rankdir=LR, fontname="DejaVu Sans", labelloc=b, fontsize=11, nodesep=0.35, ranksep=0.7, pad=0.3, splines=true,
   label=<<BR/><B>Modelo conceitual (DER) – Escolas públicas em atividade (Censo Escolar 2025)</B><BR/>Integrantes: Pâmela Cappia Torres; [inserir nome completo dos demais integrantes do grupo]<BR/>CST em Banco de Dados · Laboratório de Desenvolvimento de Banco de Dados V · Profa. Mariana Rodrigues Santesso<BR/><I>Atributos sublinhados = identificadores. Todo relacionamento é lido: lado 1 – lado N.</I>>];
 node [fontname="DejaVu Sans"]; edge [dir=none, fontname="DejaVu Sans", fontsize=12, color="#444444", fontcolor="#B00020"];
 REGIAO [shape=plain, label=<<TABLE BORDER="2" COLOR="#2E6DA4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBF7"><TR><TD BGCOLOR="#2E6DA4"><FONT COLOR="white" POINT-SIZE="12"><B>REGIÃO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código da região</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
 UF [shape=plain, label=<<TABLE BORDER="2" COLOR="#2E6DA4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBF7"><TR><TD BGCOLOR="#2E6DA4"><FONT COLOR="white" POINT-SIZE="12"><B>UNIDADE DA FEDERAÇÃO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código da UF</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sigla</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
 MUNICIPIO [shape=plain, label=<<TABLE BORDER="2" COLOR="#2E6DA4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCEBF7"><TR><TD BGCOLOR="#2E6DA4"><FONT COLOR="white" POINT-SIZE="12"><B>MUNICÍPIO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código do município</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome</FONT></TD></TR></TABLE>>];
 ESCOLA [shape=plain, label=<<TABLE BORDER="2" COLOR="#C98A00" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#FFE9B8"><TR><TD BGCOLOR="#C98A00"><FONT COLOR="white" POINT-SIZE="12"><B>ESCOLA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código da escola (INEP)</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">ano do censo</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nome da escola</FONT></TD></TR></TABLE>>];
 REDE [shape=plain, label=<<TABLE BORDER="2" COLOR="#777777" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#777777"><FONT COLOR="white" POINT-SIZE="12"><B>REDE DE ENSINO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
 DEP [shape=plain, label=<<TABLE BORDER="2" COLOR="#777777" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#777777"><FONT COLOR="white" POINT-SIZE="12"><B>DEPENDÊNCIA ADMINISTRATIVA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
 LOC [shape=plain, label=<<TABLE BORDER="2" COLOR="#777777" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#777777"><FONT COLOR="white" POINT-SIZE="12"><B>LOCALIZAÇÃO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
 LDIF [shape=plain, label=<<TABLE BORDER="2" COLOR="#777777" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#777777"><FONT COLOR="white" POINT-SIZE="12"><B>LOCALIZAÇÃO DIFERENCIADA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
 SIT [shape=plain, label=<<TABLE BORDER="2" COLOR="#777777" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#EEEEEE"><TR><TD BGCOLOR="#777777"><FONT COLOR="white" POINT-SIZE="12"><B>SITUAÇÃO DE FUNCIONAMENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10"><U>código</U></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">descrição</FONT></TD></TR></TABLE>>];
 SAN [shape=plain, label=<<TABLE BORDER="2" COLOR="#3B8B4A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF1DF"><TR><TD BGCOLOR="#3B8B4A"><FONT COLOR="white" POINT-SIZE="12"><B>SANEAMENTO</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">água potável</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">água da rede pública</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sem água</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">energia da rede pública</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sem energia</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">esgoto na rede pública</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">fossa séptica</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">sem esgoto</FONT></TD></TR></TABLE>>];
 FIS [shape=plain, label=<<TABLE BORDER="2" COLOR="#3B8B4A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF1DF"><TR><TD BGCOLOR="#3B8B4A"><FONT COLOR="white" POINT-SIZE="12"><B>DEPENDÊNCIAS FÍSICAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">banheiro</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">banheiro acessível</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">biblioteca</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">biblioteca/sala de leitura</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">laboratório de informática</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">quadra de esportes</FONT></TD></TR></TABLE>>];
 ACE [shape=plain, label=<<TABLE BORDER="2" COLOR="#3B8B4A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF1DF"><TR><TD BGCOLOR="#3B8B4A"><FONT COLOR="white" POINT-SIZE="12"><B>ACESSIBILIDADE</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">elevador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">rampas</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">nenhum recurso</FONT></TD></TR></TABLE>>];
 TEC [shape=plain, label=<<TABLE BORDER="2" COLOR="#3B8B4A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DDF1DF"><TR><TD BGCOLOR="#3B8B4A"><FONT COLOR="white" POINT-SIZE="12"><B>TECNOLOGIA</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">computador</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">internet</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">internet p/ alunos</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">internet p/ ensino</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">banda larga (se houver internet)</FONT></TD></TR></TABLE>>];
 r1 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="contém", fontsize=10, width=1.1, height=0.6];
 REGIAO -> r1 [taillabel="1", labeldistance=2, penwidth=1.4];
 r1 -> UF [headlabel="N", labeldistance=2, penwidth=1.4];
 r2 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="contém", fontsize=10, width=1.1, height=0.6];
