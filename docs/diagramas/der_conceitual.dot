 r9 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="possui", fontsize=10, width=1.1, height=0.6];
 ESCOLA -> r9 [taillabel="1", labeldistance=2, penwidth=1.4];
 r9 -> SAN [headlabel="1", labeldistance=2, penwidth=1.4];
 r10 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="possui", fontsize=10, width=1.1, height=0.6];
 ESCOLA -> r10 [taillabel="1", labeldistance=2, penwidth=1.4];
 r10 -> FIS [headlabel="1", labeldistance=2, penwidth=1.4];
 r11 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="possui", fontsize=10, width=1.1, height=0.6];
 ESCOLA -> r11 [taillabel="1", labeldistance=2, penwidth=1.4];
 r11 -> ACE [headlabel="1", labeldistance=2, penwidth=1.4];
 r12 [shape=diamond, style=filled, fillcolor="#FFFFFF", color="#444444", label="possui", fontsize=10, width=1.1, height=0.6];
